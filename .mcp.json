{
	"mcpServers": {
		"chrome-devtools": {
			"command": "npx",
			"args": ["-y", "chrome-devtools-mcp@latest"]
		},
		"inngest-cloud": {
			"type": "http",
			"url": "https://api.inngest.com/mcp"
		},
		"playwright": {
			"command": "npx",
			"args": ["@playwright/mcp@latest"]
		},
		"playwright-2": {
			"command": "npx",
			"args": ["@playwright/mcp@latest", "--isolated", "--headless"]
		},
		"playwright-3": {
			"command": "npx",
			"args": ["@playwright/mcp@latest", "--isolated", "--headless"]
		},
		"playwright-4": {
			"command": "npx",
			"args": ["@playwright/mcp@latest", "--isolated", "--headless"]
		},
		"posthog": {
			"type": "http",
			"url": "https://mcp.posthog.com/mcp"
		},
		"redbark": {
			"type": "http",
			"url": "https://mcp.redbark.com/mcp"
		},
		"shadcn": {
			"command": "npx",
			"args": ["shadcn@latest", "mcp"]
		},
		"vercel": {
			"type": "http",
			"url": "https://mcp.vercel.com"
		}
	}
}
