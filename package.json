		"@vercel/otel": "2.1.3",
		"ai": "7.0.154",
		"better-auth": "1.7.12",
		"browser-image-compression": "2.0.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.4",
		"heic-to": "1.6.6",
		"inngest": "4.26.0",
		"lucide-react": "1.57.0",
		"next": "16.4.3",
		"next-themes": "0.4.6",
		"postgres": "3.4.9",
