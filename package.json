{
	"name": "personal-finance",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.18.3",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "next build",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:check": "drizzle-kit check",
		"db:generate": "drizzle-kit generate",
		"db:custom": "drizzle-kit generate --custom",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"dev": "concurrently -k -n app,inngest -c blue,green \"pnpm dev:app\" \"pnpm dev:inngest\"",
		"dev:app": "portless run --force ./scripts/dev-app.sh",
		"dev:inngest": "portless run --force --name inngest.personal-finance ./scripts/dev-inngest.sh",
		"lint": "biome lint .",
		"postinstall": "husky || true",
		"preview": "next build && next start",
		"start": "next start",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "5.0.125",
		"@ai-sdk/otel": "1.0.154",
		"@base-ui/react": "1.9.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/api-logs": "0.222.0",
		"@opentelemetry/core": "2.11.0",
		"@opentelemetry/exporter-logs-otlp-http": "0.222.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.222.0",
		"@opentelemetry/instrumentation": "0.222.0",
		"@opentelemetry/resources": "2.11.0",
		"@opentelemetry/sdk-logs": "0.222.0",
		"@opentelemetry/sdk-metrics": "2.11.0",
		"@opentelemetry/sdk-trace-base": "2.11.0",
		"@posthog/ai": "8.14.5",
		"@t3-oss/env-nextjs": "0.13.11",
		"@tanstack/react-query": "5.104.5",
		"@trpc/client": "11.18.0",
		"@trpc/react-query": "11.18.0",
		"@trpc/server": "11.18.0",
		"@upstash/redis": "1.39.0",
		"@vercel/blob": "2.8.2",
