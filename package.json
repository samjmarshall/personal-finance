		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"concurrently": "^9.2.5",
		"drizzle-kit": "^0.31.11",
		"husky": "^9.1.7",
		"inngest-cli": "^1.46.0",
		"jsdom": "^30.1.2",
		"portless": "^0.15.7",
		"postcss": "^8.5.29",
		"shadcn": "4.22.1",
