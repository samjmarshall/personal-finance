# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# AWS Config
AWS_REGION="ap-southeast-2"
BEDROCK_RECEIPT_MODEL="au.anthropic.claude-sonnet-4-6"

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Vercel Blog Read Token
BLOB_READ_WRITE_TOKEN=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/personal-finance"

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/personal-finance"

# Redis (upstash)
KV_REST_API_TOKEN=""
KV_REST_API_URL="https://<your-upstash-id>.upstash.io"

# Redbark API
REDBARK_API_KEY=""
REDBARK_API_URL="https://api.redbark.com"

# Resend
RESEND_WEBHOOK_SECRET=""
RESEND_INBOUND_ADDRESS="receipts@finance.sammarshall.co"
RESEND_API_KEY=""

# Neon Postgres (provisioned via Neon dashboard)
NEON_PROJECT_ID=""
NEON_API_KEY=""

# PostHog - Comment out or unset POSTHOG_KEY when you do not want trace logging sent to PostHog
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
# UI host for the receipt trace-viewer deep-link (not the ingest endpoint above)
POSTHOG_UI_HOST="https://us.posthog.com"
POSTHOG_PROJECT_ID=""
LOG_LEVEL="debug"
