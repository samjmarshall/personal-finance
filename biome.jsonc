{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	// useBlockStatements has no options (braces everywhere or nowhere), so these plugins
	// keep one-line ifs legal and brace everything else.
	// Blank lines live in Oxlint (.oxlintrc.json). Why: Biome has no blank-line rule
	// (https://github.com/biomejs/biome/discussions/10879), and Grit plugins can't see
	// whitespace between statements. Exit condition: when Biome ships a padding rule, or a
	// plugin API that sees whitespace and can fix it, move the rule here. Then delete
	// .oxlintrc.json, the two dev deps, and the Oxlint steps in package.json and
	// .claude/scripts/biome-check.sh.
	"plugins": [
		"./biome-plugins/no-namespace-suspense.grit",
		"./biome-plugins/loop-braces.grit",
		"./biome-plugins/if-chain-braces.grit",
		"./biome-plugins/if-multiline-braces.grit"
	],
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended",
			"source": {
				"preset": "recommended",
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"files": {
		// Scaffolding templates: function bodies, not valid standalone modules.
		// Worktrees each carry their own biome.jsonc — exclude them to avoid the
		// "nested root configuration" error when the main repo runs biome check.
		"includes": [
			"**",
			"!.claude/skills/subagent-eval/*-template.js",
			"!.claude/worktrees",
			// Generated by pnpm; Biome 2.6 formats YAML and would fight its quoting.
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				// adr027: every loading region goes through AsyncBoundary, so skeleton,
				// status text, fade and error card can't drift between pages.
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"react": {
								"importNames": ["Suspense"],
								"message": "Use AsyncBoundary (src/components/async-boundary.tsx)."
							},
							"next/error": {
								"importNames": ["catchError"],
								"message": "Use AsyncBoundary (src/components/async-boundary.tsx)."
							}
						}
					}
				}
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"overrides": [
		{
			// The one file allowed to build on Suspense and catchError.
			"includes": ["src/components/async-boundary.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"markdown": {
		// Biome 2.6 formats Markdown by default. Docs stay hand-written; AGENTS.md is rewritten by `next dev`.
		"formatter": {
			"enabled": false
		},
		"parser": {
			"frontmatter": true
		}
	},
	"tailwind": {
		"stylesheet": "./src/styles/globals.css",
		"mergeFunctions": ["clsx", "cn"],
		"variantFunctions": ["cva"]
	}
}
