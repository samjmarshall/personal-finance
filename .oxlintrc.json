// Why: Biome has no blank-line rule (https://github.com/biomejs/biome/discussions/10879),
// and Grit plugins can't see whitespace between statements.
// Exit condition: when Biome ships a padding rule, or a plugin API that sees whitespace and
// can fix it, move this rule into Biome. Then delete this file, the two dev deps, and the
// Oxlint steps in package.json, .claude/scripts/biome-check.sh, src/test/layout-lint.test.ts
// and AGENTS.md.
// Pins: oxlint and @stylistic/eslint-plugin use exact versions because jsPlugins are alpha.
{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Biome owns every other rule, so the two tools never overlap.
	"categories": {
		"correctness": "off",
		"suspicious": "off",
		"pedantic": "off",
		"perf": "off",
		"style": "off",
		"restriction": "off",
		"nursery": "off"
	},
	"jsPlugins": ["@stylistic/eslint-plugin"],
	// Same exclusions as biome.jsonc files.includes.
	"ignorePatterns": [
		".claude/worktrees/**",
		".claude/skills/subagent-eval/*-template.js"
	],
	"rules": {
		// The last matching entry wins: "any" lets one-line ifs stack, and the
		// block-like entries after it still pad a braced if.
		"@stylistic/padding-line-between-statements": [
			"error",
			{
				"blankLine": "always",
				"prev": "*",
				"next": ["if", "for", "while", "do", "switch", "try", "block-like"]
			},
			{
				"blankLine": "always",
				"prev": ["if", "for", "while", "do", "switch", "try", "block-like"],
				"next": "*"
			},
			{ "blankLine": "any", "prev": "if", "next": "if" },
			{ "blankLine": "always", "prev": "*", "next": "block-like" },
			{ "blankLine": "always", "prev": "block-like", "next": "*" },
			{
				"blankLine": "always",
				"prev": "*",
				"next": ["return", "throw", "continue", "break"]
			}
		]
	}
}
